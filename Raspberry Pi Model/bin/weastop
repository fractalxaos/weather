#!/bin/bash
# Stops the weatherAgent process.

if [ "$HOSTNAME" == "piweather" ]; then
  AGENT_NAME="[w]eatherAgent.py"
elif [ "$HOSTNAME" == "redwall" ]; then
  AGENT_NAME="[w]eatherMirrorAgent.py"
elif [ "$HOSTNAME" == "ka7jlo-web" ]; then
  AGENT_NAME="[w]eatherMirrorAgent.py"
elif [ "$HOSTNAME" == "piweb1" ]; then
  AGENT_NAME="[w]eatherAgent.py"
else
  echo invalid host
  exit 1
fi

PROCESS_ID="$(ps x | awk -v a=$AGENT_NAME '$7 ~ a {print $1}')"

if [ -n "$PROCESS_ID" ]; then
  printf "killing weather agent [%s]\n" $PROCESS_ID
  kill $PROCESS_ID
else
  echo weatherAgent not running
fi
